{"nodes": [{"id": "reference_images_reference_live_desktop_live_desktop_ground_truth", "label": "Live Wix Site - Desktop Ground Truth @1440px", "file_type": "image", "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declared desktop ground truth per project AGENTS.md. Same section order as the 1280px live capture but the Board section renders three profile cards in a single row rather than staggered, confirming a responsive breakpoint between 1280px and 1440px. Also captures the Wix cookie-consent overlay ('keeping up with AI will DRAIN you') which obscures the footer area. Dimensions 1440x8396."}, {"id": "prizes_awards_pixelart", "label": "Prizes & Awards Pixel-Art Icon Cluster", "file_type": "concept", "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centered white rounded card with bold 'Prizes & awards' heading and body copy, surrounded by scattered pixel-art sprites (trophies, medals, first/second/third place badges) on a light gray field. The sprites are the section's whole visual identity, so dropping them guts the section. Mobile adds a 'Built on WIX CLUU' credit line."}, {"id": "desktop_layout_1440", "label": "Desktop Layout @1440px", "file_type": "concept", "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical target viewport. Two-column section headers, centered narrow content column for the Events card, side-by-side step cards inside the Application Steps block, and the three Board cards laid out in one row."}, {"id": "board_three_column_row_1440", "label": "Board Cards Three-Column Row (live @1440px)", "file_type": "concept", "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 1440px the same three cards sit flush in one horizontal row. Paired with the 1280px stagger this pins the breakpoint that the rebuild's board grid must reproduce."}, {"id": "pixel_parity_goal", "label": "Pixel Parity with Live Wix Site (Project Goal)", "file_type": "concept", "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole point of holding these five PNGs in reference-images/ is 1:1 visual fidelity to the live Wix build, judged at the two declared viewports (1440px desktop, 390px mobile). The desktop live capture is the acceptance image; local captures are the thing being measured against it. This is why screenshot deltas, not code review, are the highest-signal feedback loop in this repo."}], "edges": [{"source": "reference_images_reference_live_desktop_live_desktop_ground_truth", "target": "announcement_ticker_band", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "weight": 1.0}, {"source": "reference_images_reference_live_desktop_live_desktop_ground_truth", "target": "sticky_header_nav", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "weight": 1.0}, {"source": "reference_images_reference_live_desktop_live_desktop_ground_truth", "target": "hero_section_display_wordmark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference-images/reference_live_desktop.png", "source_location": null, "weight": 1.0}, {"source": "reference_images_reference_live_desktop_live_desktop_ground_truth", "target": "events_coming_soon_