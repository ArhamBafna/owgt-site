{"nodes": [{"id": "raw_source_code_hydrated_index_wix_thunderbolt_hydrated_dom", "label": "Wix Thunderbolt Fully Hydrated DOM (HOME | OWGT)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SSR + JS-hydrated DOM of the live Wix Studio site (thunderboltVersion 1.17973.0, published version 93, site id 52e99407-716a-46a1-bcc1-5484c1e73890). Captured because the 1:1 static rebuild must reproduce rendered output, not source intent, so the hydrated class/ARIA/testid hooks are the ground truth."}, {"id": "raw_source_code_hydrated_index_site_container", "label": "#SITE_CONTAINER Root Wrapper", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_skip_to_content_btn", "label": "SKIP_TO_CONTENT_BTN (Skip to Main Content)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visually hidden until :focus (opacity 0 -> 1, width 0 -> auto). Keyboard bypass control required for WCAG 2.4.1; the rebuild must keep the same focus-reveal behaviour."}, {"id": "raw_source_code_hydrated_index_scroll_to_top", "label": "SCROLL_TO_TOP Landmark Region", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_scroll_to_bottom", "label": "SCROLL_TO_BOTTOM Landmark Region", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_wix_ads_freemium_banner", "label": "WIX_ADS Freemium Banner ('Built on Wix Studio')", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform-injected fixed banner linking to //wix.com/studio using the Madefor-Text face. Not part of the designed OWGT page; the rebuild should drop it rather than reimplement it."}, {"id": "raw_source_code_hydrated_index_site_header", "label": "Site Header (wixui-header)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_header_wordmark", "label": "Header Wordmark Rich Text (comp-lzqr65v4, font_6)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_horizontal_menu", "label": "StylableHorizontalMenu Site Nav (Welcome / Join / Chapter)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-item top nav where Join and Chapter are same-page anchors (data-anchor) and Welcome is the current page. Mixed page-links/anchors is the structural reason the same-page anchor guard exists."}, {"id": "raw_source_code_hydrated_index_pinned_layer", "label": "Pinned Layer (comp-lzf9niav-pinned-layer)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_mobile_menu_dialog", "label": "Mobile Menu Dialog (role=dialog, aria-label='Site navigation')", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_vertical_menu", "label": "StylableVerticalMenu Items (aria-current=page on Welcome)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_anchor_join", "label": "Anchor anchors-m0awavx65 (Join)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_anchor_chapter", "label": "Anchor anchors-mry539lr (Chapter)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_anchor_rsvp", "label": "Anchor anchors-ms6p477e (RSVP)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_page_sections", "label": "<main id='PAGE_SECTIONSalkfk'> (data-main-content-parent)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_brand_mission_line", "label": "Brand Mission Line 'Empowering Through Technology'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single repeated OWGT tagline. It appears as the hero statement, as the marquee payload, and (as a STEM/education variant) as the Linktree bio, so it is the brand's shortest self-description across every property."}, {"id": "raw_source_code_hydrated_index_section_marquee_ticker", "label": "Section comp-m0ap5cxi - Text Marquee Ticker", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wixui-text-marquee with --marquee-animation-state: running and --marquee-duration: 26.38s. The payload unit is cloned ~8x per track with aria-hidden duplicates purely to fill the loop, so the rebuild must emit the same clone count or the seam will show."}, {"id": "raw_source_code_hydrated_index_marquee_play_toggle", "label": "Marquee Play/Pause Toggle (aria-label='Play Marquee', aria-pressed)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WCAG 2.2.2 pause/stop/hide: an auto-moving >5s marquee must offer a user-controlled pause. aria-pressed carries the play state and drives the --marquee-clicked custom property."}, {"id": "raw_source_code_hydrated_index_marquee_pause_on_hover", "label": "Marquee Pause-on-Hover (--marquee-clicked)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".ZpRWNC:hover sets --marquee-clicked:paused so hovering the ticker stops it; :focus on the track also pauses. Motion is opt-out by intent on both pointer and keyboard."}, {"id": "raw_source_code_hydrated_index_marquee_logo_separator_svg", "label": "DOM-Store Separator SVG c837a6_... (172x172, 3 brand colors)", "file_type": "image", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inlined once into <defs id='dom-store-defs'> and re-referenced by <use href='#c837a6_...'> for every separator, so the pixel logo costs one definition regardless of marquee length. Fills are var(--svg-color-1,#1C1C1C) / #FCED54 / #FF49A6."}, {"id": "raw_source_code_hydrated_index_hero_section", "label": "Section comp-lzqoqdk9 - Hero h1 'OneWorld GreaterTogether'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_hero_decorative_vectors", "label": "Hero Decorative Vector Images (comp-m09mbnqx, comp-m0us2vqs)", "file_type": "image", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absolutely positioned with --motion-left/--motion-top pixel offsets and data-motion-enter='done', i.e. the hero art is placed by absolute motion coords rather than flow layout."}, {"id": "raw_source_code_hydrated_index_events_section", "label": "Section comp-lzf9ni60 - Events 'Events Coming Soon / To Be Determined'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_rsvp_button", "label": "RSVP Button (comp-m0c54tyd, data-semantic-classname='button')", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An in-page anchor CTA, not an outbound RSVP form: it carries data-anchor='anchors-ms6p477e' and href back to the same page, so clicking must scroll rather than navigate."}, {"id": "raw_source_code_hydrated_index_stylable_button", "label": "StylableButton2545352419 Token Pattern", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All button visuals (colour, radius, border, per-state hover/disabled) flow from --corvid-* CSS custom properties onto one root class, so restyling a CTA never needs a new class or markup change."}, {"id": "raw_source_code_hydrated_index_volunteer_section", "label": "Section comp-m09l6er9 - 'Want to volunteer?'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recruitment pitch that trades on reciprocity: 'For volunteering, hours and recognition will be given.' Immediately followed by the Application Steps section, so the pitch and the process are one flow."}, {"id": "raw_source_code_hydrated_index_application_steps_section", "label": "Section comp-m0awavx1 - 'Application Steps'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only two numbered steps, and step 2 names a 1-2 week email SLA to oneworldgreatertogether@gmail.com before the meeting and acceptance gates. The email is part of the published process contract, not incidental contact info."}, {"id": "raw_source_code_hydrated_index_volunteer_google_form", "label": "Volunteer Google Form 1FAIpQLSfauNjJtauYoJVWCbJ-x_DOIImOuDt_KVne1F6-_Ilmvt_xFw", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_contact_email", "label": "oneworldgreatertogether@gmail.com", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_board_section", "label": "Section comp-m029jcz0 - 'Board'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_board_artham_juvariwala", "label": "Artham Juvariwala - President / Founder", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-describes as founder and president, 'started OWGT inspired to make a change in my community, now educating thousands'. Establishes OWGT as founder-led rather than institution-backed."}, {"id": "raw_source_code_hydrated_index_board_panshul_kadam", "label": "Panshul Kadam - Vice President (Marketing / Media)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns marketing and media outreach - the role that plausibly drives the parallel Linktree/Instagram/YouTube/X surface, coupling the social channels to the main site."}, {"id": "raw_source_code_hydrated_index_board_arham_bafna", "label": "Arham Bafna - Vice President (Operations / New Events / Expansion)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles day-to-day operations, new events and chapter expansion - i.e. the role behind the 'Start a chapter' and 'Events' sections."}, {"id": "raw_source_code_hydrated_index_start_chapter_section", "label": "Section comp-lzjn6ufe - 'How to start a chapter?'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Federation play: fill a short form, then read a guidelines PDF. Low-friction form first, long document second, so chapter leads self-serve without a human in the loop."}, {"id": "raw_source_code_hydrated_index_chapter_start_form", "label": "Chapter Start Form (forms.gle/krULzEFWJ2JaJBEb9)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_chapter_guidelines_pdf", "label": "OWGT_Chapter_Official_Guidlines_and_Outline.pdf (Discord CDN)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted on cdn.discordapp.com with a signed ?ex=/&is=/&hm= query that expires. Chapter documentation depends on a temporary Discord CDN link rather than durable first-party hosting, so it will rot."}, {"id": "raw_source_code_hydrated_index_prizes_awards_section", "label": "Section comp-lztsllqf - 'Prizes & awards'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 29 KB of markup with almost no text, this is the heaviest section on the page; the reward framing (100+ hours, recognition letter, board positions) is what converts a chapter lead into a repeat volunteer."}, {"id": "raw_source_code_hydrated_index_volunteer_hours_incentive", "label": "Volunteer Incentive (100+ hrs/yr, recognition letter, board positions)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly monetises participation in non-cash terms (school hours, a letter, a path to leadership), so the incentive is what substitutes for salary in a youth volunteer org."}, {"id": "raw_source_code_hydrated_index_empty_anchor_section", "label": "Section comp-ms6p46mm (empty trailing section)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered section container with bgLayers/bgMedia but zero content children. Its id stem (ms6p46mm) is near the RSVP anchor id (ms6p477e) yet not equal, so it is very likely a scroll-offset/spacer target whose real purpose is unconfirmed."}, {"id": "raw_source_code_hydrated_index_site_footer", "label": "Site Footer (wixui-footer)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_footer_copyright", "label": "Footer Copyright 'c 2026 by OWGT'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_footer_501c3", "label": "Footer Statement 'a 501 (c) 3 organization'", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only legal/regulatory claim anywhere on the site, and it sits in the footer rather than an About page - a deliberate low-friction placement so it never interrupts the recruitment funnel."}, {"id": "raw_source_code_hydrated_index_typography_scale", "label": "Typography Scale font_0..font_9 with --theme-spx-ratio", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sizes are fluid, not fixed: font_8 is max(14px, min(20px, calc(16 * var(--theme-spx-ratio)))). One ratio variable drives every clamp, so a rebuild must carry the same scale to match both 1440px and 390px targets."}, {"id": "raw_source_code_hydrated_index_font_familjen_grotesk", "label": "Familjen Grotesk (italic 400/700, latin + latin-ext)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundled from the Google Fonts tag-bundler cache with display:swap and a four-weight italic/roman matrix. The italic is loaded as a separate WOFF2 from the roman, so the rebuild must ship both files or the italic hero will substitute."}, {"id": "raw_source_code_hydrated_index_font_din_next", "label": "DIN Next W01 Light (Wix-hosted woff2, 3 unicode subsets)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "raw_source_code_hydrated_index_brand_palette", "label": "Brand Palette (#1C1C1C ink, #FCED54 yellow, #FF49A6 pink, #F73D18 close red)", "file_type": "concept", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colours appear as raw hex only inside the pixel logo and the close-icon SVG; the rest of the page is driven by --color_N / --font_N custom properties. The palette is therefore split between hard-coded asset fills and tokenised theme references, which a rebuild must reconcile."}, {"id": "raw_source_code_hydrated_index_aria_forced_colors_focus", "label": "Forced-Colors Focus Ring (#a11y-contrast block)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only active under @media (forced-colors: active), it re-adds a 2px CanvasText outline because the global reset sets :focus{outline:none}. Windows High Contrast would otherwise leave keyboard users with no visible focus."}, {"id": "raw_source_code_hydrated_index_same_page_anchor_guard", "label": "Same-Page Anchor Guard (window.__tbAnchorGuard)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture-phase click listener that preventDefaults only when the click resolves to a same-origin same-pathname a[data-anchor]. It exists purely to stop MPA-style reloads on Join/Chapter before hydration attaches scroll handling - direct evidence that anchor nav is the site's primary in-page interaction."}, {"id": "raw_source_code_hydrated_index_speculation_rules_prefetch", "label": "Speculation Rules (mpa-prefetch-eager, excludes /owgt)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefetches every same-site path except the current /owgt page. Since the only real destinations are the same-page anchors plus the Google Form, the rule mainly warms cross-property navigation."}, {"id": "raw_source_code_hydrated_index_view_transitions", "label": "MPA View Transitions (header-group / footer-group / page-group)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "header/footer are hoisted to their own view-transition-name so they persist across page navigations while only the page group animates - a deliberate continuity device for a single-page-feeling site."}, {"id": "raw_source_code_hydrated_index_motion_enter_clip", "label": "Motion Enter Clip Wipe (--motion-clip-start, data-motion-enter)", "file_type": "code", "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entrance reveals are clip-path polygons (e.g. polygon(0% 0%,100% 0%,100% 0%,0% 0%) plus --motion-translate-y: 100%) rather than opacity fades; the hydrated DOM shows data-motion-enter='done' meaning the reveal has already resolved."}], "edges": [{"source": "raw_source_code_hydrated_index_wix_thunderbolt_hydrated_dom", "target": "raw_source_code_hydrated_index_site_container", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "weight": 1.0}, {"source": "raw_source_code_hydrated_index_site_container", "target": "raw_source_code_hydrated_index_skip_to_content_btn", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "weight": 1.0}, {"source": "raw_source_code_hydrated_index_site_container", "target": "raw_source_code_hydrated_index_scroll_to_top", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "weight": 1.0}, {"source": "raw_source_code_hydrated_index_site_container", "target": "raw_source_code_hydrated_index_scroll_to_bottom", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "raw-source-code/hydrated-index.html", "source_location": null, "weight": 1.0}, {"source": "raw_source_code_hydrated_index_scroll_to_top", "target": "raw_source_code_hydrated_index_scroll_to_bottom", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 