{"nodes": [{"id": "docs_visual_discrepancies_report", "label": "Visual Inspection Report: Local HTML vs Live Wix Site", "file_type": "document", "source_file": "docs/visual_discrepancies.md", "source_location": "L1-L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produced after a custom Playwright slow-scroll capture revealed massive differences between the ctrl+u copy and the live site."}, {"id": "docs_visual_discrepancies_missing_events_box", "label": "Discrepancy 1: Missing Events Box", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L11-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live site has a light blue 'Events Coming Soon' box under the hero with a red 'To Be Determined' button and a black 'RSVP' button; the local copy dropped it entirely."}, {"id": "docs_visual_discrepancies_empty_application_steps", "label": "Discrepancy 2: Empty Application Steps Section", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L15-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The large red box is populated on the live site with a Step 1 white card plus pixel email icon and a Step 2 white card; locally it renders empty."}, {"id": "docs_visual_discrepancies_missing_board_photos", "label": "Discrepancy 3: Missing Board Member Photos", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L21-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each of the three board cards carries a large photograph (Artham outside, Panshul with a skyline, Arham by a campfire); only white text cards rendered locally."}, {"id": "docs_visual_discrepancies_missing_chapter_robot_image", "label": "Discrepancy 4: Missing Chapter Robot Photograph", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L25-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_visual_discrepancies_missing_pixel_art", "label": "Discrepancy 5: Missing Floating Pixel Art", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L29-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trophy, coin, ice cream cone, retro handheld console and space invader ring the white Prizes & awards card on the live site."}, {"id": "docs_visual_discrepancies_missing_footer_content", "label": "Discrepancy 6: Missing Footer Content", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L33-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White footer with logo text, 'a 501 (c) 3 organization', copyright and an email address was a blank void locally."}, {"id": "docs_visual_discrepancies_ssr_skeleton_cause", "label": "Root Cause: Wix SSR Skeleton Copy", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L39-L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ctrl+u copies Server-Side Rendered HTML only; Wix omits image src attributes and leaves animation containers empty until scroll, so the local file is a skeleton."}, {"id": "docs_visual_discrepancies_lazy_load_intersection_observers", "label": "Wix Lazy Loading & Intersection Observers", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side JavaScript injects images and content only after intersection observers fire on scroll."}, {"id": "docs_visual_discrepancies_post_scroll_dom_capture", "label": "Fix: Capture DOM After Scrolling to Bottom", "file_type": "concept", "source_file": "docs/visual_discrepancies.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a scraper / Save Page As, or manually extract the missing image URLs and content from the live DOM and inject them into index.html."}], "edges": [{"source": "docs_visual_discrepancies_report", "target": "docs_visual_discrepancies_missing_events_box", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual_discrepancies.md", "source_location": "L11-L13", "weight": 1.0}, {"source": "docs_visual_discrepancies_report", "target": "docs_visual_discrepancies_empty_application_steps", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual_discrepancies.md", "source_location": "L15-L19", "weight": 1.0}, {"source": "docs_visual_discrepancies_report", "target": "docs_visual_discrepancies_missing_board_photos", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual_discrepancies.md", "source_location": "L21-L23", "weight": 1.0}, {"source": "docs_visual_discrepancies_report", "target": "docs_visual_discrepancies_missing_chapter_robot_image", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual_discrepancies.md", "source_location": "L25-L27", "weight": 1.0}, {"source": "docs_visual_discrepancies_report", "target": "docs_visual_discrepancies_missing_pixel_art", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual_discrepancies.md", "source_location": "L29-L31", "weight": 1.0}, {"source": "docs_visual_discrepancies_report", "target": "docs_visual_discrepancies_missing_footer_content", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual_discrepancies.md", "source_location": "L33-L35", "weigh