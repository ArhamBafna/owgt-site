{"nodes": [{"id": "assets_images_hero_bg_hero_background", "label": "Hero Background (pastel abstract gradient field)", "file_type": "image", "source_file": "assets/images/hero_bg.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-photographic / abstract render, wide ~3:2. An extremely light, high-key field of soft blended lavender, powder blue, blush pink and warm peach with faint wispy cloud/mist forms and near-white luminous centre; no text, no figures, no hard edges. Chosen as the hero canvas so overlaid headlines, CTAs and the logo stay high-contrast and legible at 1440px and 390px."}, {"id": "assets_images_hero_bg_low_contrast_overlay_safety", "label": "Low-Contrast Overlay Safety", "file_type": "concept", "source_file": "assets/images/hero_bg.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The hero background is deliberately washed out to near-white with a bright centre so that dark headline text, buttons and the black-and-blue logo can sit on top of it at full contrast. It is a text canvas, not a picture; the tint is atmosphere, the emptiness is the actual job."}, {"id": "assets_images_hero_bg_abstract_pastel_gradient_aesthetic", "label": "Abstract Pastel Gradient Aesthetic", "file_type": "concept", "source_file": "assets/images/hero_bg.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lavender, blush and powder blue with soft mist edges and no hard geometry. Chosen to feel warm, optimistic and non-corporate, and to avoid the visual noise of a photo competing with the headline. It sits opposite the saturated documentary photography used further down the page."}], "edges": [{"source": "assets_images_hero_bg_hero_background", "target": "assets_images_hero_bg_low_contrast_overlay_safety", "relation": "implements", "confidence": "EXTRACTED", 